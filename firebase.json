{
  "_comment": "Hosting only. Site rapidrx-portal on project rapidrx-portal. myrapidrx.web.app is reserved by another project. Do not deploy functions from here.",
  "hosting": {
    "site": "rapidrx-portal",
    "public": "portal",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "overview.html",
      "alerts.html",
      "sync.html",
      "demo.html",
      "apk.html",
      "app.js",
      "demo-family.json",
      "rules_test.md"
    ],
    "headers": [
      {
        "source": "rapidrx.package",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"rapidrx.apk\""
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
